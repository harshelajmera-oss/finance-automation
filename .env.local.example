# Copy this file to .env.local and fill in values from your Supabase project
# settings (Project Settings → API). Never commit .env.local — it is already
# in .gitignore.

# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, never exposed to the browser.
# Used to create new user accounts from the admin screen.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — server-side only. Used to read fields off uploaded
# documents. Create one at console.anthropic.com under API Keys.
ANTHROPIC_API_KEY=
